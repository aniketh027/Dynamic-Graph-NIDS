# Python caches and build outputs
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
build/
dist/

# Local environments
.venv/
venv/
env/

# Editors, local agent settings, and operating-system files
.vscode/
.idea/
.claude/settings.local.json
.DS_Store
Thumbs.db
Desktop.ini

# Raw datasets are local-only and must never be redistributed
data/raw/csv/*
data/raw/parquet/*
data/raw/*.csv
data/raw/*.csv.gz
!data/raw/.gitkeep
!data/raw/README.md

# Generated Stage C data, including local recovery copies
data/processed/*
!data/processed/.gitkeep
data/processed/preprocessed/
data/processed/preprocessed_run2/
data/processed/preprocessed_pre_collision_fix/
data/processed/preprocessed_run2_pre_collision_fix/

# Runtime and temporary disk-backed processing files
scratch/
*.memmap
*.mmap
*.tmp
*.temp

# Model/runtime outputs
checkpoints/*
!checkpoints/.gitkeep
*.pt
*.pth
*.ckpt
*.safetensors
plots/*
!plots/.gitkeep
logs/*
!logs/.gitkeep

# Results are generated by default. Re-include only compact milestone evidence.
results/*
!results/.gitkeep
!results/stage_c_full_validation.json
!results/data_profile/
!results/data_profile/**
!results/inspection/
results/inspection/*
!results/inspection/INSPECTION_REPORT.md
